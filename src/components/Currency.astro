---
import { Image } from 'astro:assets';
import Wood from '../images/v01/Wood.png';
import Food from '../images/v01/Food.png';
import Gold from '../images/v01/Gold.png';
import Crystal from '../images/v01/Crystal.png';
const { category } = Astro.props;

const iconMap = {
    wood: Wood,
    food: Food,
    gold: Gold,
    crystal: Crystal
};
const icon = iconMap[category];
---

<Image
    src={icon}
    alt={category}
    height={20}
    format="webp"
    quality={100}
    class="inline-icon"
/>